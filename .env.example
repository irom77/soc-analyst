# Copy this file to .env and replace the placeholders.
# A bare model name is sent to CASE_ANALYZER_BASE_URL over the OpenAI-compatible path,
# as is any opaque name containing a slash (meta-llama/Llama-3). Prefix with gemini/ to
# use Google's native API instead; openai/<name> forces the compatible path if an
# endpoint's own model name collides with a native prefix.
CASE_ANALYZER_MODEL=your-model
CASE_ANALYZER_API_KEY=your-key
CASE_ANALYZER_BASE_URL=https://provider.example/v1
VIRUSTOTAL_API_KEY=your-virustotal-key
ABUSEIPDB_API_KEY=your-abuseipdb-key

# Optional: reach Google's native API directly, without an OpenAI-compatible endpoint.
# CASE_ANALYZER_MODEL=gemini/gemini-2.5-flash
# CASE_ANALYZER_BASE_URL=

# Optional: route through a LiteLLM proxy instead — still useful for centralized keys,
# budgets, or a shared deployment (see examples/litellm-proxy/README.md). The proxy
# holds the real provider key in its own environment; the value below is a placeholder.
# CASE_ANALYZER_MODEL=gemini-native
# CASE_ANALYZER_BASE_URL=http://localhost:4000/v1
# CASE_ANALYZER_API_KEY=sk-local
