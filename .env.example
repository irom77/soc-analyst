# Copy this file to .env and replace the placeholders.
CASE_ANALYZER_MODEL=your-model
CASE_ANALYZER_API_KEY=your-key
CASE_ANALYZER_BASE_URL=https://provider.example/v1
VIRUSTOTAL_API_KEY=your-virustotal-key
ABUSEIPDB_API_KEY=your-abuseipdb-key

# Optional: route through a LiteLLM proxy to use a provider with no OpenAI-compatible
# endpoint (see examples/litellm-proxy/README.md). The proxy holds the real provider
# key in its own environment; the value below is only a placeholder the proxy accepts.
# CASE_ANALYZER_MODEL=gemini-native
# CASE_ANALYZER_BASE_URL=http://localhost:4000/v1
# CASE_ANALYZER_API_KEY=sk-local
